# Paste into Dokploy → Application → Environment. Never commit real values.
# production | dev   (dev shows a DEV badge and tags e-mails with [dev])
APP_ENV=dev
# First admin account — used only when the database has no users yet. Change the password at first sign-in.
ADMIN_USERNAME=hassan
ADMIN_PASSWORD=change-me-to-a-long-random-text
# Public address, used for links in e-mails
PUBLIC_URL=https://dev.hr.nama.omanste.com
SESSION_HOURS=12
# Muscat time — nightly database copy in /data/backups, kept BACKUP_KEEP_DAYS days
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=14
# Your own mail server (optional — leave SMTP_HOST empty to switch e-mail off)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# DEV ONLY (APP_ENV=dev): login page shows a staff list and everyone signs in with this shared password.
# Defaults to 2026 on dev; empty switches it off. Ignored completely when APP_ENV=production. Admin accounts keep their own password.
# DEV_SHARED_PASSWORD=2026
